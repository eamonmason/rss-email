{
  "name": "rss-email-eval",
  "version": "1.0.0",
  "description": "promptfoo fidelity eval for the RSS Brief (isolated from the CDK dependency tree)",
  "private": true,
  "scripts": {
    "eval": "PROMPTFOO_PYTHON=../.venv/bin/python promptfoo eval -c promptfooconfig.yaml",
    "eval:view": "promptfoo view"
  },
  "devDependencies": {
    "promptfoo": "^0.122.2"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1",
    "brace-expansion": "^5.0.8",
    "smol-toml": "^1.8.0",
    "fast-uri": "^3.1.6"
  }
}
